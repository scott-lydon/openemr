{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/public/app/features/dashboard/types/dashboardJson.ts",
  "_comment": "Clinical Co-Pilot operational dashboard. Eight panels per W2_QUALITY_PLAN section 11.2. Imported from clinical-copilot/grafana/clinical_copilot_dashboard.json into Grafana via the API or the UI Import button. Datasource UID is templated; replace with the deployment's Prometheus datasource UID before saving.",
  "title": "Clinical Co-Pilot",
  "uid": "clinical-copilot-w2",
  "schemaVersion": 38,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "tags": ["w2", "agentic", "clinical-copilot"],
  "time": {"from": "now-24h", "to": "now"},
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {"text": "Prometheus", "value": "prometheus"}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Encounter latency by intent (p50 / p95 / p99)",
      "type": "timeseries",
      "datasource": "${datasource}",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "ms"}},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum(rate(copilot_encounter_duration_ms_bucket[5m])) by (intent_kind, le))", "legendFormat": "p50 {{intent_kind}}"},
        {"expr": "histogram_quantile(0.95, sum(rate(copilot_encounter_duration_ms_bucket[5m])) by (intent_kind, le))", "legendFormat": "p95 {{intent_kind}}"},
        {"expr": "histogram_quantile(0.99, sum(rate(copilot_encounter_duration_ms_bucket[5m])) by (intent_kind, le))", "legendFormat": "p99 {{intent_kind}}"}
      ]
    },
    {
      "id": 2,
      "title": "Cost per encounter (rolling 24h / 7d)",
      "type": "timeseries",
      "datasource": "${datasource}",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "currencyUSD"}},
      "targets": [
        {"expr": "sum(rate(copilot_encounter_cost_usd_sum[24h])) / sum(rate(copilot_encounter_cost_usd_count[24h]))", "legendFormat": "rolling 24h"},
        {"expr": "sum(rate(copilot_encounter_cost_usd_sum[7d])) / sum(rate(copilot_encounter_cost_usd_count[7d]))", "legendFormat": "rolling 7d"}
      ]
    },
    {
      "id": 3,
      "title": "Queue depth + dead-letter count",
      "type": "stat",
      "datasource": "${datasource}",
      "gridPos": {"x": 0, "y": 8, "w": 8, "h": 6},
      "targets": [
        {"expr": "copilot_agent_jobs_state{state=\"queued\"}", "legendFormat": "queued"},
        {"expr": "copilot_agent_jobs_state{state=\"running\"}", "legendFormat": "running"},
        {"expr": "copilot_agent_jobs_state{state=\"dead_letter\"}", "legendFormat": "dead_letter"}
      ]
    },
    {
      "id": 4,
      "title": "Eval pass rate per rubric category",
      "type": "bargauge",
      "datasource": "${datasource}",
      "gridPos": {"x": 8, "y": 8, "w": 8, "h": 6},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "thresholds": {"steps": [{"color": "red", "value": 0}, {"color": "orange", "value": 0.7}, {"color": "green", "value": 0.92}]}}},
      "targets": [
        {"expr": "copilot_eval_pass_rate", "legendFormat": "{{rubric_category}}"}
      ]
    },
    {
      "id": 5,
      "title": "Reranker availability + degradation rate",
      "type": "timeseries",
      "datasource": "${datasource}",
      "gridPos": {"x": 16, "y": 8, "w": 8, "h": 6},
      "fieldConfig": {"defaults": {"unit": "percentunit"}},
      "targets": [
        {"expr": "rate(copilot_retrieval_degraded_total[5m]) / rate(copilot_retrieval_total[5m])", "legendFormat": "degraded fraction"}
      ]
    },
    {
      "id": 6,
      "title": "VLM extraction confidence distribution",
      "type": "histogram",
      "datasource": "${datasource}",
      "gridPos": {"x": 0, "y": 14, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum(rate(copilot_extraction_confidence_bucket[5m])) by (le))", "legendFormat": "p50"},
        {"expr": "histogram_quantile(0.05, sum(rate(copilot_extraction_confidence_bucket[5m])) by (le))", "legendFormat": "p05"}
      ]
    },
    {
      "id": 7,
      "title": "Sanitization layer block counts",
      "type": "timeseries",
      "datasource": "${datasource}",
      "gridPos": {"x": 12, "y": 14, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum(rate(copilot_sanitize_blocked_total[5m])) by (layer)", "legendFormat": "{{layer}}"}
      ]
    },
    {
      "id": 8,
      "title": "PHI scrubbed by kind",
      "type": "timeseries",
      "datasource": "${datasource}",
      "gridPos": {"x": 0, "y": 22, "w": 24, "h": 6},
      "targets": [
        {"expr": "sum(rate(copilot_phi_redactions_total[5m])) by (kind)", "legendFormat": "{{kind}}"}
      ]
    }
  ]
}
