# Local-dev environment overrides for the OpenEMR development-easy stack.
#
# Copy this file to `.env` (which is gitignored) and fill in the values.
# Docker Compose automatically reads `.env` next to docker-compose.yml.
#
# Generate a strong secret with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#
# The same value must also be set in clinical-copilot/.env as
# COPILOT_OPENEMR_DOC_PUSH_SECRET so the sidecar can authenticate to
# OpenEMR's store-document.php endpoint.
COPILOT_STORE_DOCUMENT_SECRET=replace_me_with_a_high_entropy_token
